// Sukahati Yoga — schema modeled on project/Data Model.dc.html (15 tables,
// grouped: people, catalogue, booking engine, money, operations).
// Runs on Postgres (Supabase). Enum-like columns are still plain strings
// validated in application code (see src/domain/enums.ts) rather than
// native Postgres enums, and text[] columns are JSON-encoded strings —
// kept from the original SQLite-compatible design so the schema isn't
// tied to one database. A handful of display-copy columns (marked below)
// were added beyond the proposed schema so the booking UI's exact wording
// ("A first visit", "Free up to 12h before", …) is real, editable data
// rather than hardcoded frontend strings.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (Supabase's transaction pooler, port 6543) — used by
  // the running app for normal queries.
  url       = env("DATABASE_URL")
  // Direct, unpooled connection (port 5432) — used only for schema changes
  // (`prisma db push` / `migrate`). Required because Supabase's transaction
  // pooler doesn't support the session-level advisory lock Prisma takes
  // during a schema push; against the pooler that lock just hangs forever.
  directUrl = env("DIRECT_URL")
}

// ── People and access ──────────────────────────────────────────────────

model User {
  id             String    @id @default(cuid())
  fullName       String
  email          String    @unique
  phoneE164      String?
  passwordHash   String? // set for email/password accounts; null for future OAuth-only accounts
  authProvider   String    @default("email") // email | phone | google
  role           String    @default("customer") // customer | desk | teacher | owner
  locale         String    @default("en")
  timezone       String    @default("Asia/Kuala_Lumpur")
  currency       String    @default("MYR")
  loyaltyPoints  Int       @default(0)
  referralCode   String    @unique
  adminNotes     String    @default("") // internal studio notes, staff-only
  referredById   String?
  referredBy     User?     @relation("Referrals", fields: [referredById], references: [id])
  referrals      User[]    @relation("Referrals")
  createdAt      DateTime  @default(now())
  deletedAt      DateTime?

  preferences     UserPreferences?
  teacherProfile  Teacher?
  bookings        Booking[]
  notifications   Notification[]
  waitlistEntries WaitlistEntry[]
  auditLogs       AuditLog[]
}

model UserPreferences {
  userId             String    @id
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  usualLevel         String? // Beginner | Intermediate | Advanced
  preferredTime      String? // Mornings | Afternoons | Evenings
  mealPreference     String?
  injuryNotes        String?
  pushEnabled        Boolean   @default(true)
  emailEnabled       Boolean   @default(true)
  whatsappEnabled    Boolean   @default(true)
  smsEnabled         Boolean   @default(false)
  marketingConsentAt DateTime?
}

model Location {
  id              String   @id @default(cuid())
  name            String
  kind            String // studio | retreat
  address         String?
  timezone        String   @default("Asia/Kuala_Lumpur")
  defaultCurrency String   @default("MYR")
  isActive        Boolean  @default(true)

  packages       Package[]
  classTemplates ClassTemplate[]
  sessions       Session[]
  retreats       Retreat[]
  rooms          Room[]
}

// ── Catalogue ───────────────────────────────────────────────────────────

model Package {
  id                   String  @id @default(cuid())
  locationId           String
  location             Location @relation(fields: [locationId], references: [id])
  name                 String
  kind                 String // single | pass | private | online | retreat
  priceMinor           Int
  currency             String  @default("MYR")
  billingUnit          String // e.g. "per class", "7 days unlimited"
  validityDays         Int?
  creditCount          Int?
  capacityPerSession   Int? // null = unlimited
  maxGuestsPerBooking  Int     @default(6)
  inclusions           String // JSON string[]
  exclusions           String // JSON string[]
  cancellationHours    Int     @default(12)
  isVisible            Boolean @default(true)
  isRecommended        Boolean @default(false)
  badge                String?
  sortOrder            Int     @default(0)

  // Display copy (beyond the proposed schema — see file header).
  shortDescription String  @default("")
  longDescription  String  @default("")
  goodFor          String  @default("")
  category         String  @default("")
  durationLabel    String  @default("")
  ratingLabel      String  @default("")
  capacityLabel    String  @default("")
  cancelLabel      String  @default("")
  validLabel       String  @default("")

  images   PackageImage[]
  bookings Booking[]
  retreat  Retreat?
  coupons  Coupon[]
}

model PackageImage {
  id         String  @id @default(cuid())
  packageId  String
  package    Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
  storageKey String
  altText    String  @default("")
  position   Int     @default(0)
}

model ClassTemplate {
  id                String  @id @default(cuid())
  locationId        String
  location          Location @relation(fields: [locationId], references: [id])
  title             String
  category          String // Flow | Hatha | Yin | Private | Online
  level             String // "all levels" | "intermediate" | ...
  durationMinutes   Int
  weekday           Int // 0=Sun .. 6=Sat
  startTime         String // "07:00"
  defaultTeacherId  String
  defaultTeacher    Teacher  @relation(fields: [defaultTeacherId], references: [id])
  defaultRoomId     String
  defaultRoom       Room     @relation(fields: [defaultRoomId], references: [id])
  capacity          Int
  ratingLabel       String   @default("")

  sessions Session[]
}

// ── Booking engine ─────────────────────────────────────────────────────

model Session {
  id                  String    @id @default(cuid())
  templateId          String?
  template            ClassTemplate? @relation(fields: [templateId], references: [id])
  locationId          String
  location            Location  @relation(fields: [locationId], references: [id])
  retreatId           String?
  retreat             Retreat?  @relation(fields: [retreatId], references: [id])
  title               String
  startsAt            DateTime
  endsAt              DateTime
  teacherId           String
  teacher             Teacher   @relation(fields: [teacherId], references: [id])
  roomId              String
  room                Room      @relation(fields: [roomId], references: [id])
  capacity            Int
  seatsTaken          Int       @default(0)
  status              String    @default("scheduled") // scheduled | full | cancelled | blocked
  priceOverrideMinor  Int?

  bookings        Booking[]
  waitlistEntries WaitlistEntry[]

  @@index([teacherId, startsAt])
  @@index([roomId, startsAt])
}

model Retreat {
  id             String    @id @default(cuid())
  packageId      String    @unique
  package        Package   @relation(fields: [packageId], references: [id])
  locationId     String
  location       Location  @relation(fields: [locationId], references: [id])
  startsOn       DateTime
  endsOn         DateTime
  checkInAt      String // "14:00"
  checkOutAt     String // "11:00"
  totalPlaces    Int
  placesTaken    Int       @default(0)
  earlyBirdUntil DateTime?

  sessions Session[]
  bookings Booking[]
}

model Booking {
  id               String    @id @default(cuid())
  reference        String    @unique
  userId           String
  user             User      @relation(fields: [userId], references: [id])
  packageId        String
  package          Package   @relation(fields: [packageId], references: [id])
  sessionId        String?
  session          Session?  @relation(fields: [sessionId], references: [id])
  retreatId        String?
  retreat          Retreat?  @relation(fields: [retreatId], references: [id])
  guestCount       Int       @default(1)
  level            String?
  specialRequests  String    @default("")
  status           String    @default("pending") // pending | confirmed | cancelled | no_show | attended
  subtotalMinor    Int
  discountMinor    Int       @default(0)
  totalMinor       Int
  amountPaidMinor  Int       @default(0)
  currency         String    @default("MYR")
  couponId         String?
  coupon           Coupon?   @relation(fields: [couponId], references: [id])
  qrToken          String    @unique
  checkedInAt      DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime  @default(now())

  addons        BookingAddon[]
  payments      Payment[]
  notifications Notification[]
}

model Addon {
  id         String  @id @default(cuid())
  name       String
  priceMinor Int
  isActive   Boolean @default(true)

  bookingAddons BookingAddon[]
}

model BookingAddon {
  id             String  @id @default(cuid())
  bookingId      String
  booking        Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  addonId        String
  addon          Addon   @relation(fields: [addonId], references: [id])
  quantity       Int     @default(1)
  unitPriceMinor Int
}

model WaitlistEntry {
  id             String    @id @default(cuid())
  sessionId      String
  session        Session   @relation(fields: [sessionId], references: [id])
  userId         String
  user           User      @relation(fields: [userId], references: [id])
  position       Int
  notifiedAt     DateTime?
  holdExpiresAt  DateTime?
  status         String    @default("waiting") // waiting | offered | claimed | expired

  @@unique([sessionId, userId])
}

// ── Money ───────────────────────────────────────────────────────────────

model Payment {
  id                String    @id @default(cuid())
  bookingId         String
  booking           Booking   @relation(fields: [bookingId], references: [id])
  kind              String // deposit | balance | full | refund
  method            String // card | fpx | grabpay | apple_pay | cash
  amountMinor       Int // refunds are negative
  currency          String    @default("MYR")
  fxRate            Float     @default(1)
  status            String    @default("paid") // pending | paid | failed | refunded
  providerIntentId  String    @default("")
  receiptUrl        String    @default("")
  dueAt             DateTime?
  paidAt            DateTime?
  createdAt         DateTime  @default(now())
}

model Coupon {
  id                    String   @id @default(cuid())
  code                  String   @unique
  discountType          String // percent | fixed
  discountValue         Int
  appliesToPackageId    String?
  appliesToPackage      Package? @relation(fields: [appliesToPackageId], references: [id])
  minGuests             Int      @default(1)
  startsAt              DateTime @default(now())
  expiresAt             DateTime
  maxRedemptions        Int      @default(1000000)
  redemptionCount       Int      @default(0)
  isActive              Boolean  @default(true)
  detailLabel           String   @default("") // display copy, e.g. "10% off · retreat only"

  bookings Booking[]
}

// ── Operations and comms ──────────────────────────────────────────────

model Teacher {
  id             String  @id @default(cuid())
  userId         String? @unique
  user           User?   @relation(fields: [userId], references: [id])
  name           String
  specialties    String // JSON string[]
  weeklyHourCap  Int     @default(20)

  classTemplates ClassTemplate[]
  sessions       Session[]
}

model Room {
  id               String  @id @default(cuid())
  locationId       String
  location         Location @relation(fields: [locationId], references: [id])
  name             String
  matCapacity      Int?
  isAccommodation  Boolean  @default(false)
  beds             Int?
  note             String   @default("") // e.g. "street level", "candles allowed"

  classTemplates ClassTemplate[]
  sessions       Session[]
}

model Notification {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id])
  bookingId         String?
  booking           Booking?  @relation(fields: [bookingId], references: [id])
  event             String // booking_confirmed | payment_received | reminder_7d | reminder_24h | cancelled | schedule_changed | payment_due | waitlist_open
  channel           String // push | email | sms | whatsapp
  title             String
  body              String
  scheduledFor      DateTime  @default(now())
  sentAt            DateTime?
  readAt            DateTime?
  providerMessageId String    @default("")
}

model AuditLog {
  id            Int      @id @default(autoincrement())
  actorUserId   String
  actor         User     @relation(fields: [actorUserId], references: [id])
  entityTable   String
  entityId      String
  action        String // create | update | delete | refund
  diff          String // JSON
  ipAddress     String   @default("")
  createdAt     DateTime @default(now())
}

// Marks one-time migration/cleanup scripts (in prisma/seed.ts) as done, so
// they run exactly once across the app's lifetime rather than re-matching
// real data on every deploy. See wipeFakePeople() in seed.ts for why this
// matters: without it, a real customer who happens to reuse one of the old
// prototype's demo emails would get silently deleted on every deploy.
model SeedFlag {
  id    String   @id
  ranAt DateTime @default(now())
}

// Small settings table backing the admin "Automations" toggle list — not one
// of the 15 core tables, added so those switches persist against real state.
model AutomationSetting {
  id       String  @id
  name     String
  note     String
  isActive Boolean @default(true)
  sortOrder Int    @default(0)
}

// ── Guest teacher registration ─────────────────────────────────────────
// Separate from `Teacher` (the internal roster that teaches scheduled
// studio classes). A TeacherProfile is created once per person from the
// public /teacher-registration form; every subsequent registration by the
// same person (matched on email or phone) attaches a new TeacherVisit to
// the same profile instead of creating a duplicate.

model TeacherProfile {
  id                  String   @id @default(cuid())
  teacherCode         String   @unique // "SY-T-000001"
  fullName            String
  preferredName       String   @default("")
  email               String   @unique
  phone               String
  country             String   @default("")
  city                String   @default("")
  profilePhotoUrl     String   @default("") // data URL
  instagram           String   @default("")
  website             String   @default("")
  bio                 String   @default("")
  yearsExperience     String   @default("")
  certification       String   @default("")
  certificationSchool String   @default("")
  certificationLevel  String   @default("")
  teachingStyles      String   @default("[]") // JSON string[]
  teachingSpecialties String   @default("")
  certificationFileUrl String  @default("") // data URL
  status              String   @default("pending") // pending | approved | active | archived
  adminNotes          String   @default("")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  visits        TeacherVisit[]
  sessions      TeacherSession[]
  notifications TeacherNotification[]
}

model TeacherVisit {
  id                 String    @id @default(cuid())
  teacherProfileId   String
  teacherProfile     TeacherProfile @relation(fields: [teacherProfileId], references: [id])
  visitType          String // guest_teacher | workshop | retreat | teacher_training | private_session | special_event | other
  status             String    @default("pending") // pending | confirmed | completed | cancelled
  title              String    @default("")
  description        String    @default("")
  proposedDate       DateTime?
  numberOfSessions   Int       @default(1)
  expectedStudents   Int?
  sessionDuration    String    @default("")
  preferredTime      String    @default("")
  websiteIntro       String    @default("")
  socialLinks        String    @default("")
  equipmentNeeds     String    @default("")
  travelNotes        String    @default("")
  dietaryNeeds       String    @default("")
  additionalComments String    @default("")
  agreedToTerms      Boolean   @default(false)
  createdAt          DateTime  @default(now())

  sessions TeacherSession[]
}

model TeacherSession {
  id               String    @id @default(cuid())
  teacherVisitId   String
  teacherVisit     TeacherVisit @relation(fields: [teacherVisitId], references: [id], onDelete: Cascade)
  teacherProfileId String
  teacherProfile   TeacherProfile @relation(fields: [teacherProfileId], references: [id])
  date             DateTime?
  startTime        String    @default("")
  endTime          String    @default("")
  className        String    @default("")
  yogaStyle        String    @default("")
  duration         String    @default("")
  capacity         Int       @default(0)
  bookingCount     Int       @default(0)
  status           String    @default("scheduled") // scheduled | completed | cancelled
}

// A logged record of what would be sent to the teacher (registration
// received, approved, reminder). No email/SMS provider is wired up yet —
// see server README — so these are a communication log the admin can read,
// not a delivery guarantee.
model TeacherNotification {
  id               String   @id @default(cuid())
  teacherProfileId String
  teacherProfile   TeacherProfile @relation(fields: [teacherProfileId], references: [id])
  event            String // registration_received | approved | reminder
  channel          String // email | whatsapp
  title            String
  body             String
  sentAt           DateTime @default(now())
}
