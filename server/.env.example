DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:YOUR-PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxxxxxxxxxx:YOUR-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"
PORT=4000

# Signs customer/staff login tokens — set this to a long random string in production.
JWT_SECRET="change-me-to-a-long-random-string"

# The one studio-staff account the seed script creates/updates on every deploy.
# Sign in with these at /admin to reach the studio dashboard.
OWNER_EMAIL="owner@example.com"
OWNER_PASSWORD="change-me"
